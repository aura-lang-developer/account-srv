// 11. POST /api/v1/transactions/transfer
fn (h: WalletHttpHandler) HandleTransfer(req: Request, res: Response): Unit => {
  let bodyStr = if (req.rawBody != ()) { req.rawBody } else { "{}" };
  let payload = if (bodyStr != "" && bodyStr != "{}") {
    JSON.parse(bodyStr)
  } else {
    {}
  };

  let srcId = if (payload.sourceAccountId != ()) { `${payload.sourceAccountId}` } else { "" };
  let dstNum = if (payload.destinationAccountNumber != ()) { `${payload.destinationAccountNumber}` } else { "" };
  let amount: Float = if (payload.amount != ()) { payload.amount } else { 0.0 };
  let desc = if (payload.description != ()) { `${payload.description}` } else { "Transferencia entre billeteras" };

  let dto: TransferDTO = {
    sourceAccountId: srcId,
    destinationAccountNumber: dstNum,
    amount: amount,
    description: desc
  };

  let xferRes = h.txUseCase.ProcessTransfer(dto, GetNowMs());
  match xferRes {
    Ok(tx) => {
      http.json(res, 201, {
        success: true,
        message: "Transferencia ejecutada exitosamente con doble partida en Ledger",
        data: tx
      });
    },
    Err(err) => {
      http.json(res, 400, {
        success: false,
        error: err
      });
    }
  };
};

// 12. GET /api/v1/transactions
fn (h: WalletHttpHandler) HandleListTransactions(req: Request, res: Response): Unit => {
  let listRes = h.txUseCase.ListRecentTransactions(50);
  match listRes {
    Ok(txs) => {
      http.json(res, 200, {
        success: true,
        count: len(txs),
        data: txs
      });
    },
    Err(err) => {
      http.json(res, 500, {
        success: false,
        error: err
      });
    }
  };
};

// 13. GET /api/v1/transactions/{id}
fn (h: WalletHttpHandler) HandleGetTransaction(req: Request, res: Response): Unit => {
  let txId = http.pathValue(req, "id");
  let queryRes = h.txUseCase.GetTransactionById(txId);
  match queryRes {
    Ok(tx) => {
      http.json(res, 200, {
        success: true,
        data: tx
      });
    },
    Err(err) => {
      http.json(res, 404, {
        success: false,
        error: err
      });
    }
  };
};

// 14. GET /api/v1/ledger/accounts/{id}
fn (h: WalletHttpHandler) HandleGetAccountLedger(req: Request, res: Response): Unit => {
  let accountId = http.pathValue(req, "id");
  let queryRes = h.ledgerUseCase.GetAccountLedger(accountId);
  match queryRes {
    Ok(entries) => {
      http.json(res, 200, {
        success: true,
        accountId: accountId,
        count: len(entries),
        data: entries
      });
    },
    Err(err) => {
      http.json(res, 404, {
        success: false,
        error: err
      });
    }
  };
};

// 15. GET /api/v1/ledger/accounts/{id}/reconcile
fn (h: WalletHttpHandler) HandleReconcileAccount(req: Request, res: Response): Unit => {
  let accountId = http.pathValue(req, "id");
  let recRes = h.ledgerUseCase.ReconcileAccount(accountId, GetNowMs());
  match recRes {
    Ok(summary) => {
      http.json(res, 200, {
        success: true,
        accountId: accountId,
        reconciliation: summary
      });
    },
    Err(err) => {
      http.json(res, 400, {
        success: false,
        error: err
      });
    }
  };
};

// 16. GET /api/v1/ledger
fn (h: WalletHttpHandler) HandleListLedger(req: Request, res: Response): Unit => {
  let listRes = h.ledgerUseCase.ListAllEntries();
  match listRes {
    Ok(entries) => {
      http.json(res, 200, {
        success: true,
        count: len(entries),
        data: entries
      });
    },
    Err(err) => {
      http.json(res, 500, {
        success: false,
        error: err
      });
    }
  };
};
